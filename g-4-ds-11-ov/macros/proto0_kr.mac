# To run with visualization: ./g4ds ../macros/proto0_kr.mac Qt

/ds/manager/log trace
/ds/manager/verbosity 0
/ds/manager/checkoverlap 1
/ds/manager/eventcounter 100
/ds/manager/writephotons 0
/ds/manager/writedeposits 1
/ds/manager/writedaughters 0

# Define output file name
/run/filename proto_kr

# Define  random seed
#/run/heprandomseed 127677

#Define the hadronic physics list (none HP QGSP_BERT_HP QGSP_BIC_HP FTF_BIC_HP FTFP_BERT_HP)
# /ds/physics/hadronic_list HP
/ds/physics/hadronic_list none

#Define the EM physics list (standard livermore)
/ds/physics/em_list livermore

# 
#/ds/physics/DriftField 0 V/cm
/ds/physics/tuned200V   1

# Kills photons
/ds/physics/killS1S2 1

#Detector configuration:
/ds/detector/configuration dsproto0
/ds/detector/protoproto/buildfloor false
/ds/detector/protoproto/buildscintillator true

#-----------------------------------
/run/initialize
#-----------------------------------

#
# Generate 83mKr, isotropically distributed in the active volume
#
/ds/generator/select RDM
/ds/stack/select RDM
/ds/generator/rdm/ion 83 36 41.55 
/ds/generator/energy 0. eV

# Block for confined isotropic source
# If the confinement is active, the direction is always isotropic
#
/ds/generator/postype Volume		       
/ds/generator/posshape Sphere
/ds/generator/setradius 15 cm
/ds/generator/set_center 0 0 -310 mm #This is the center of Active Volume
/ds/generator/confine ActiveLAr
#

# Define the number of events
/tracking/verbose 0
/run/beamOn 10000
